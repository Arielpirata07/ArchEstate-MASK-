# Copiá este archivo a .env y completá los valores. Nunca commitees .env.

# --- Core (requerido) ---
SECRET_KEY=cambia-esta-clave-por-una-aleatoria-larga
SITE_URL=http://localhost:5000

# --- Base de datos ---
# Vacío = SQLite local (database.db). Para PostgreSQL usá la URL de conexión.
DATABASE_URL=

# --- Cookies / entorno ---
PREFER_SECURE_COOKIES=false
STAGING=false
FLASK_DEBUG=false

# --- Admin inicial (solo producción) ---
# Si no se define, se genera una y se guarda en .admin_initial_password.
ADMIN_INITIAL_PASSWORD=

# --- Twilio (OTP SMS/WhatsApp) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
TWILIO_WHATSAPP_BUTTON_CONTENT_SID=
TWILIO_WHATSAPP_LEAD_CONTENT_SID=
# true = usa verificadores simulados aunque haya credenciales (evita límites de trial).
TWILIO_SIMULATE=false

# --- SMTP (emails transaccionales) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Observabilidad / backups (opcional) ---
SENTRY_DSN=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=us-east-1

# --- Redis (pendiente: rate limiting) ---
REDIS_URL=
