# Configuración de ArchEstate - Plantilla de ejemplo
# Copia este archivo a .env y completa los valores

# Clave secreta para Flask (genera una nueva con: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-here-change-in-production

# Configuración de base de datos (opcional - por defecto usa database.db en la raíz)
# DATABASE_PATH=database.db

# Configuración de producción (cambiar a 'true' para producción)
DEBUG=false

# Twilio - Verificación telefónica (SMS y WhatsApp)
# Obtener credenciales en: https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=

# Twilio - Template de WhatsApp con botón "Verificar" (requiere aprobación de Meta)
# Crear en: https://console.twilio.com/ > Content > Templates
# Body: "Hola {{3}}, tu código de verificación de ArchEstate es: {{1}} (válido {{2}} min)"
# Botón Quick Reply: texto "✅ Verificar" — reply "VERIFICAR"
# TWILIO_WHATSAPP_BUTTON_CONTENT_SID=

# Twilio - Modo simulación (true = códigos impresos en consola, false = envío real)
TWILIO_SIMULATE=true

# SMTP - Envío de emails transaccionales
# Usar credenciales de Gmail/Outlook o servicio SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@archestate.com
