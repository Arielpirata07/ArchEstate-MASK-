# Configuración de ArchEstate - Plantilla de ejemplo
# Copia este archivo a .env y completa los valores

# Clave secreta para Flask (genera una nueva con: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your-secret-key-here-change-in-production

# Entorno staging (true = se omiten ciertos fixes/limpiezas de datos)
# STAGING=false

# Base de datos (por defecto usa SQLite local: database.db)
# Para producción con Neon (PostgreSQL):
# DATABASE_URL=postgresql://user:pass@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# URL de Redis para rate limiting (Render KV)
# REDIS_URL=rediss://red-xxxxx:6379

# URL del sitio (para links absolutos en WhatsApp CTA, emails, etc.)
# SITE_URL=https://tudominio.com

# Cookies seguras (true en producción con HTTPS)
# PREFER_SECURE_COOKIES=true

# Twilio - Verificación telefónica (SMS y WhatsApp)
# Obtener credenciales en: https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=

# Twilio - Template de WhatsApp con botón "Verificar" (requiere aprobación de Meta)
# Crear en: https://console.twilio.com/ > Content > Templates
# Body: "Hola {{3}}, tu código de verificación de ArchEstate es: {{1}} (válido {{2}} min)"
# Botón Quick Reply: texto "✅ Verificar" — reply "VERIFICAR"
# TWILIO_WHATSAPP_BUTTON_CONTENT_SID=

# Twilio - Template de WhatsApp para notificación de nuevo lead a profesionales
# TWILIO_WHATSAPP_LEAD_CONTENT_SID=

# Twilio - Modo simulación (true = códigos impresos en consola, false = envío real)
TWILIO_SIMULATE=true

# SMTP - Envío de emails transaccionales
# Usar credenciales de Gmail/Outlook o servicio SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@archestate.com

# Monitorización de errores (Sentry)
# SENTRY_DSN=

# Contraseña inicial del usuario admin (solo primer arranque en producción; si no se setea se genera y guarda en .admin_initial_password)
# ADMIN_INITIAL_PASSWORD=
